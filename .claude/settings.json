{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "korean",
  "outputStyle": "Diagram First",
  "plansDirectory": "./.claude/plans",
  "feedbackSurveyRate": 0,
  "model": "sonnet",
  "effortLevel": "high",
  "defaultShell": "powershell",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(.env.example)",
      "Write(.env.example)",
      "Edit(.env.example)",
      "PowerShell(git status)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git branch)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -v)",
      "PowerShell(npm run *)",
      "PowerShell(npx *)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(ls*)",
      "PowerShell(Get-Content *)"
    ],
    "deny": [
      "Read(.codex/**)",
      "Edit(.codex/**)",
      "Write(.codex/**)",
      "Read(.opencode/**)",
      "Edit(.opencode/**)",
      "Write(.opencode/**)",
      "Read(AGENTS.md)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Read(AGENTS.override.md)",
      "Edit(AGENTS.override.md)",
      "Write(AGENTS.override.md)",
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(.env.*)",
      "Edit(.env.*)",
      "Write(.env.*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Write(**/.env.*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Write(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Write(**/*.p12)",
      "Read(**/secrets.*)",
      "Edit(**/secrets.*)",
      "Write(**/secrets.*)"
    ],
    "ask": [
      "PowerShell(git push*)",
      "PowerShell(git reset*)",
      "PowerShell(git rebase*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore*)",
      "PowerShell(git clean*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(npm publish*)",
      "PowerShell(git branch -D*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./.claude/scripts/statusline.ps1"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "두뇌 풀가동",
      "종말을 기다리는 중",
      "음모를 꾸미는 중",
      "파멸을 준비하는 중",
      "세계정복을 계획하는 중",
      "악마를 소환하는 중"
    ]
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen"
}
