{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "korean",
  "outputStyle": "Diagram First",
  "plansDirectory": "./.claude/plans",
  "feedbackSurveyRate": 0,
  "model": "sonnet",
  "effortLevel": "high",
  "defaultShell": "powershell",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [],
    "deny": [],
    "ask": []
  },
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./.claude/scripts/statusline.ps1"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "두뇌 풀가동",
      "종말을 기다리는 중",
      "음모를 꾸미는 중",
      "파멸을 준비하는 중"
    ]
  },
  "autoUpdatesChannel": "stable"
}
